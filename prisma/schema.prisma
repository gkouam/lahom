generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  SUPER_ADMIN
}

enum Permission {
  MANAGE_MEMBERS
  VIEW_MEMBERS
  MANAGE_FINANCES
  MANAGE_MEETINGS
  MANAGE_EVENTS
  MANAGE_PERMISSIONS
  MANAGE_GALLERY
}

enum FinancialStanding {
  NEW
  GOOD_STANDING
  BEHIND
  EXEMPT
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RsvpResponse {
  GOING
  MAYBE
  NOT_GOING
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  name          String?
  phone         String?
  role          Role           @default(MEMBER)
  accountStatus AccountStatus  @default(PENDING_APPROVAL)
  hometown      String?
  officerTitle  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  rsvps              Rsvp[]
  announcements      Announcement[]
  auditLogs          AuditLog[]
  userPermissions    UserPermission[]          @relation("UserHeldPermissions")
  grantedPermissions UserPermission[]          @relation("PermissionGrantedBy")
  financialStatus    MemberFinancialStatus?    @relation("MemberStatus")
  statusUpdates      MemberFinancialStatus[]   @relation("StatusUpdatedBy")
  contributions      Contribution[]            @relation("MemberContributions")
  recordedContribs   Contribution[]            @relation("ContribRecordedBy")
  meetingNotes       MeetingNote[]             @relation("MeetingNoteAuthor")
}

model UserPermission {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation("UserHeldPermissions", fields: [userId], references: [id], onDelete: Cascade)
  permission Permission

  grantedById String?
  grantedBy   User?      @relation("PermissionGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

model MemberFinancialStatus {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation("MemberStatus", fields: [userId], references: [id], onDelete: Cascade)

  standing         FinancialStanding @default(NEW)
  totalContributed Decimal           @default(0) @db.Decimal(10, 2)
  notes            String?

  lastUpdatedById  String?
  lastUpdatedBy    User?             @relation("StatusUpdatedBy", fields: [lastUpdatedById], references: [id], onDelete: SetNull)
  updatedAt        DateTime          @updatedAt
  createdAt        DateTime          @default(now())

  @@index([standing])
}

model Contribution {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("MemberContributions", fields: [userId], references: [id], onDelete: Cascade)

  amount       Decimal  @db.Decimal(10, 2)
  date         DateTime
  method       String?
  description  String?

  recordedById String
  recordedBy   User     @relation("ContribRecordedBy", fields: [recordedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId, date])
}

model MeetingNote {
  id        String   @id @default(cuid())
  title     String?
  titleFr   String?
  body      String?
  bodyFr    String?
  date      DateTime

  authorId  String
  author    User     @relation("MeetingNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model GalleryImage {
  id           String   @id @default(cuid())
  url          String
  label        String
  labelFr      String?
  caption      String
  captionFr    String?
  span         String?
  published    Boolean  @default(true)
  sortOrder    Int      @default(0)
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([published, sortOrder])
}

model Event {
  id            String   @id @default(cuid())
  title         String?
  titleFr       String?
  description   String?
  descriptionFr String?
  date          DateTime
  time          String?
  location      String?
  color         String   @default("red")
  capacity      Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rsvps Rsvp[]
}

model Rsvp {
  id       String       @id @default(cuid())
  userId   String
  eventId  String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event    Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  response RsvpResponse @default(GOING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, eventId])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  titleFr     String?
  body        String
  bodyFr      String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MembershipRequest {
  id        String        @id @default(cuid())
  email     String
  name      String
  phone     String?
  hometown  String?
  message   String?
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model LoginAttempt {
  id            String   @id @default(cuid())
  email         String
  ipAddress     String
  userAgent     String?
  success       Boolean
  failureReason String?
  createdAt     DateTime @default(now())

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}
